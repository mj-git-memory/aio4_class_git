# Supabase Connect 화면의 Session pooler 연결 정보
host=YOUR_SESSION_POOLER_HOST
port=5432
dbname=postgres
user=postgres.YOUR_PROJECT_REF
password=YOUR_DATABASE_PASSWORD
# Render에서는 true, 로컬 HTTP에서는 false
COOKIE_SECURE=false
# 위 DB와 같은 Supabase 프로젝트의 Auth 설정 (service_role 키 불필요)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_SESSION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
