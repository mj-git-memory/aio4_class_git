erDiagram
    users ||--o{ orders : places
    users ||--o{ auth_sessions : authenticates
    orders ||--o{ order_items : contains
    products ||--o{ order_items : selected_in
    orders ||--o| payments : paid_by

    users {
        bigint id PK
        varchar name
        varchar email UK
        uuid auth_user_id UK
        text role
        varchar address
        boolean active
        timestamptz created_at
    }
    products {
        bigint id PK
        text name UK
        text description
        text category
        integer price
        integer stock
        text emoji
        boolean active
    }
    orders {
        bigint id PK
        bigint user_id FK
        text status
        text fulfillment_status
        integer total
        varchar shipping_address
        timestamptz created_at
        timestamptz paid_at
    }
    order_items {
        bigint id PK
        bigint order_id FK
        bigint product_id FK
        text product_name
        integer unit_price
        integer quantity
    }
    payments {
        bigint id PK
        bigint order_id FK, UK
        integer amount
        text method
        text status
        timestamptz created_at
    }
    auth_sessions {
        text token_hash PK
        text access_token
        text refresh_token
        bigint token_expires_at
        bigint user_id FK
        timestamptz expires_at
    }
